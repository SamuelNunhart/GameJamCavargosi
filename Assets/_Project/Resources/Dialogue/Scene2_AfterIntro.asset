MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2846490e87135c94c80c2665f6defa8e, type: 3}
  m_Name: Scene2_AfterIntro
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Ghost
    text: Get up, Arthur.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Arthur
    text: Where are you, I can't see you.
    side: 1
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: That's not important.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: What matters... is that I can see you.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Now look around...
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Arthur
    text: What do you mean? What am I supposed to see? I'm just in my room.
    side: 1
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: You think nothing is happening only because you're not present.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Life doesn't pause when you look down on your screen.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Just look through your window.
    side: 0
    voiceClip: {fileID: 0}
