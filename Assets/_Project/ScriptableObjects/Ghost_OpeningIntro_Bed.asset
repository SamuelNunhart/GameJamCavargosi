  lines:
  - speakerName: Arthur
    text: Okay, just one more reel and I will go to bed. This one actually looks
      cool.
    side: 1
    voiceClip: {fileID: 8300000, guid: b3b07c59315146f46804cbcc99db2f20, type: 3}
  - speakerName: Ghost
    text: "You\u2019ve already said \u201Cone more reel\u201D 15 times today."
