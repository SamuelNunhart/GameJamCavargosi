  lines:
  - speakerName: Ghost
    text: Good. Now look carefully, Arthur.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Arthur
    text: What is this supposed to show me?
    side: 1
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Everything you keep telling yourself you'll get back to.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Neglect doesn't disappear... it just waits behind closed doors.
    side: 0
    voiceClip: {fileID: 0}
