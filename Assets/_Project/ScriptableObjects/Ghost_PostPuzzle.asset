  lines:
  - speakerName: Ghost
    text: It's not as easy as you expected, was it?
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Did you enjoy it?
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Arthur
    text: No... I really couldn't focus. It kept pulling me away.
    side: 1
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: That's the point. Distraction ruins everything.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Come. Let me show you something... Open the door.
    side: 0
    voiceClip: {fileID: 0}
