  m_Script: {fileID: 11500000, guid: 2846490e87135c94c80c2665f6defa8e, type: 3}
  m_Name: Ghost_PuzzleIntro
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Arthur
    text: Oh... my puzzles...
    side: 1
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: You used to focus on things you enjoyed... without interruption.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: But now, when notifications interrupt you, it's much harder to enjoy these little things.
    side: 0
    voiceClip: {fileID: 0}
  - speakerName: Arthur
    text: No... it's not that bad...
    side: 1
    voiceClip: {fileID: 0}
  - speakerName: Ghost
    text: Okay, then try it...
    side: 0
    voiceClip: {fileID: 0}
